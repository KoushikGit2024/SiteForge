{
  "manifest_version": 3,
  "name": "SiteForge",
  "minimum_chrome_version": "110",
  "version": "1.0.0",
  "description": "Deconstruct any webpage into an architectural CAD blueprint, inspect layout metrics, and export clean components.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SiteForge Blueprint (Alt+Shift+B)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Construct architectural blueprint of the active page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
